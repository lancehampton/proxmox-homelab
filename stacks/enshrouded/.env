# Server
SERVER_NAME=757
SERVER_SLOT_COUNT=16
SERVER_QUERYPORT=15637
SERVER_IP=0.0.0.0
SERVER_SAVE_DIR=./savegame
SERVER_LOG_DIR=./logs

# Voice/Chat
SERVER_VOICE_CHAT_MODE=Proximity
SERVER_ENABLE_VOICE_CHAT=false
SERVER_ENABLE_TEXT_CHAT=false

# Permissions
PUID=4711
PGID=4711

# Updates
UPDATE_CRON=0 * * * *
UPDATE_CHECK_PLAYERS=true

# Backups
BACKUP_CRON=*/15 * * * *
BACKUP_DIR=./backups
BACKUP_MAX_COUNT=56

# Restarts
RESTART_CRON=0 3 * * *
RESTART_CHECK_PLAYERS=true

# Steam
GAME_BRANCH=public
STEAMCMD_ARGS=validate

# Server Roles (SERVER_PASSWORD is deprecated - use roles instead)
SERVER_ROLE_0_NAME=Admins
# SERVER_ROLE_0_PASSWORD=
SERVER_ROLE_0_CAN_KICK_BAN=true
SERVER_ROLE_0_CAN_ACCESS_INVENTORIES=true
SERVER_ROLE_0_CAN_EDIT_WORLD=true
SERVER_ROLE_0_CAN_EDIT_BASE=true
SERVER_ROLE_0_CAN_EXTEND_BASE=true
SERVER_ROLE_0_RESERVED_SLOTS=1

SERVER_ROLE_1_NAME=Friends
# SERVER_ROLE_1_PASSWORD=
SERVER_ROLE_1_CAN_ACCESS_INVENTORIES=true
SERVER_ROLE_1_CAN_EDIT_WORLD=true
SERVER_ROLE_1_CAN_EDIT_BASE=true
SERVER_ROLE_1_CAN_EXTEND_BASE=true
SERVER_ROLE_1_RESERVED_SLOTS=0

# =============================================================================
# Difficulty — set to Relaxed preset
# Custom settings below are commented out; uncomment and set PRESET=Custom to use
# =============================================================================
SERVER_GS_PRESET=Relaxed
