(cloudflare) {
  tls {
    dns cloudflare {$CLOUDFLARE_API_TOKEN}
  }
}

# birdnet
birdnet.{$TAILNET_CNAME} {
  reverse_proxy http://apps:8080
  import cloudflare
}

# glance
home.{$TAILNET_CNAME} {
  reverse_proxy http://apps:3080
  import cloudflare
}

