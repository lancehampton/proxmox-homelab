(cloudflare) {
  tls {
    dns cloudflare {$CLOUDFLARE_API_TOKEN}
  }
}

# birdnet
birdnet.{$TAILSCALE_CNAME} {
  reverse_proxy http://apps:8080
  import cloudflare
}

# glance
home.{$TAILSCALE_CNAME} {
  reverse_proxy http://apps:3080
  import cloudflare
}

# readeck
readeck.{$TAILSCALE_CNAME} {
  reverse_proxy http://apps:8000
  import cloudflare
}

# wud
wud.{$TAILSCALE_CNAME} {
  reverse_proxy http://apps:3090
  import cloudflare
}

# komodo
komodo.{$TAILSCALE_CNAME} {
  reverse_proxy http://apps:9120
  import cloudflare
}
